<%-include("partials/head.ejs")%>

<body>
<%- include("./partials/nav.ejs") %>

    <h1>Hva trenger du for at skolehverdagen skal bli litt bedre?</h1>

   <section class="middle">
  <form action="" method="post">
    <label for="forslag">Skriv inn forslag</label>
    <input type="text" name="forslag" id="forslag" placeholder="">
    <button type="submit">send in</button>
  </form>
</section>

<h2>Skole forslagene</h2>

<section>
  <div class="skole">
    <% alleForslag.forEach(function(f) { %>
      <div class="komment">
        <p><%= f.tekst %></p>

        <div class="feedFeature">
          <div class="person">
            <% if (f.bruker) { %>
              <%= f.bruker.kjønn%>
              <%= f.bruker.alder%>
            <% } else { %>
              <p>Ukjent</p>
            <% } %>
          </div>
          <div class="commentSection">

          </div>
          <div class="like">

          </div>
        </div>
      </div>
    <% }); %>
  </div>
</section>

</body>