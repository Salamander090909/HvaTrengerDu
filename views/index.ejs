<%-include("partials/head.ejs")%>

<body>
  <%- include("./partials/nav.ejs") %>

  <main class="innhold">

    <section class="rightTextBox">
      <h1>Hva trenger du for at skolehverdagen skal bli litt bedre?</h1>

      <form class="forslagForm" action="" method="post">
        <div class="forslag">
          <label for="forslag">Skriv inn forslag</label>
          <input type="text" name="forslag" id="forslag" placeholder="">
        </div>
        <button type="submit">send in</button>
      </form>
    </section>

    <div class="skole">
      <% alleForslag.forEach(function(f) { %>
        <div class="post">

          <div class="komment">
            <p><%= f.tekst %></p>

            <div class="feedFeature">
              <div class="person">
                <% if (f.bruker) { %>
                  <p><%= f.bruker.kjønn %></p>
                  <p><%= f.bruker.alder %></p>
                <% } else { %>
                  <p>Gjest</p>
                <% } %>
              </div>

              <button type="button" class="kommenterBtn">
                kommenter
              </button>

              <div class="like">
                <p>like</p>
              </div>
            </div>
          </div>

          <div class="commentSection" id="kommentarer-<%= f._id %>" hidden>
            <ul class="kommentarListe">
              <% f.kommentarer.forEach(function(k) { %>
                <li><%= k.tekst %></li>
              <% }); %>
            </ul>

            <form class="kommentarForm" action="/kommenter/<%= f._id %>" method="post">
              <label for="kommentarTekst<%= f._id %>">Skriv en kommentar</label>
              <input type="text" name="kommentarTekst" id="kommentarTekst<%= f._id %>" placeholder="Skriv en kommentar..." required>
              <button type="submit">Send</button>
            </form>
          </div>

        </div>
      <% }); %>
    </div>

  </main>

</body>